NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL used by sitemap.js/robots.js to build absolute URLs.
# Defaults to https://warytools.com — only set this for a deployment on a
# different domain (e.g. a staging environment).
# NEXT_PUBLIC_SITE_URL=

# Error tracking (Sentry). Same DSN value in both — NEXT_PUBLIC_ one is
# exposed to the browser for client-side error capture, SENTRY_DSN is used
# server/edge-side. Leave unset to run without error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: only needed to upload sourcemaps to Sentry during `next build`.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
