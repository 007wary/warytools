NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL used by sitemap.js/robots.js/llms.txt and JSON-LD to
# build absolute URLs. Defaults to https://wary.tools — only set this for a
# deployment on a different domain (e.g. a staging environment). A trailing
# slash is normalized away, and a value with no scheme falls back to the
# default (see src/lib/siteUrl.js).
#
# Note: on Vercel, preview deploys serve robots.txt with "Disallow: /" so a
# *.vercel.app copy of the site can't be indexed alongside the canonical
# domain. That's keyed off VERCEL_ENV, which Vercel sets automatically —
# nothing to configure here.
# NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave unset in
# dev and preview deploys — analytics only loads when this is present.
NEXT_PUBLIC_GA_ID=

# Error tracking (Sentry). Same DSN value in both — NEXT_PUBLIC_ one is
# exposed to the browser for client-side error capture, SENTRY_DSN is used
# server/edge-side. Leave unset to run without error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: only needed to upload sourcemaps to Sentry during `next build`.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PDF to Word converter (services/pdf-to-word). Both are server-only — note
# the deliberate absence of NEXT_PUBLIC_: a converter secret in the browser
# bundle would be no secret at all, and the service would be open to anyone.
#
# Leave unset to run the site without the converter: /api/pdf-to-word then
# returns a clean "temporarily unavailable" message instead of failing hard,
# so local dev and previews work without deploying the container.
#
# See services/pdf-to-word/README.md for the deploy steps.
PDF_CONVERTER_URL=
PDF_CONVERTER_SECRET=

# Word to PDF converter (services/word-to-pdf). Same rules as above: both are
# server-only, and leaving them unset makes /api/word-to-pdf report a clean
# "temporarily unavailable" rather than failing hard.
#
# Use a DIFFERENT secret from the PDF converter's. They are separate services
# on separate hosts, and sharing one secret means a compromise of either is a
# compromise of both.
#
# See services/word-to-pdf/README.md for the deploy steps.
WORD_CONVERTER_URL=
WORD_CONVERTER_SECRET=

# PowerPoint to PDF converter (services/powerpoint-to-pdf). Same rules again:
# both are server-only, and leaving them unset makes /api/powerpoint-to-pdf
# report a clean "temporarily unavailable" rather than failing hard.
#
# Use a THIRD distinct secret. All three converters are separate services on
# separate hosts; sharing a secret between any two makes a compromise of one a
# compromise of both.
#
# Note this is a different container from WORD_CONVERTER_URL even though both
# run LibreOffice — that one installs Writer, this one installs Impress, and a
# Writer-only image fails every .pptx while looking perfectly healthy.
#
# See services/powerpoint-to-pdf/README.md for the deploy steps.
POWERPOINT_CONVERTER_URL=
POWERPOINT_CONVERTER_SECRET=

# Contact form (/contact -> /api/contact). Server-only, deliberately not
# NEXT_PUBLIC_: a mail-sending API key in the browser bundle would let anyone
# send email as us.
#
# Leave unset to run the site without the form working: /api/contact then
# returns a clean "temporarily unavailable" message instead of failing hard,
# so local dev and previews work without a Resend account.
#
# RESEND_API_KEY   — from https://resend.com/api-keys
# CONTACT_TO_EMAIL — the inbox that receives submissions (a personal address;
#   kept out of the code so it never lands in the repo or a bundle).
# CONTACT_FROM_EMAIL — optional. Defaults to "WaryTools <hello@wary.tools>",
#   which requires wary.tools to be verified in Resend. Set it to
#   "WaryTools <onboarding@resend.dev>" to send via Resend's shared domain
#   before verification completes — useful for a preview deploy.
#
# The sender's own address always goes in Reply-To, never in From: mail
# claiming to be From an address on a domain we don't control is exactly what
# SPF/DMARC reject, so it would land in spam.
#
# hello@wary.tools only SENDS. The domain has no MX records, so nothing is
# delivered to it — replies go to the visitor's address, and anything a person
# sends to hello@ bounces. Add MX records if that inbox is ever wanted.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Excel to PDF converter (services/excel-to-pdf). Same rules as the other
# three converters: server-only, a FOURTH distinct secret, and leaving them
# unset makes /api/excel-to-pdf report a clean "temporarily unavailable".
#
# This container installs LibreOffice Calc AND ships convert.bas — the macro
# that applies the page-setup options. An image without the macro converts
# successfully using Calc's defaults and says nothing, which is why the
# service refuses to boot unless its probe gets an "ok" status token back.
#
# See services/excel-to-pdf/README.md for the deploy steps.
EXCEL_CONVERTER_URL=
EXCEL_CONVERTER_SECRET=

# Newsletter (/api/newsletter/*). All server-only.
#
# NEWSLETTER_TOKEN_SECRET — HMAC key signing the confirm and unsubscribe links
#   in every email. Those links carry no session, so the signature IS the
#   authorization: this key in a browser bundle would let anyone unsubscribe
#   anyone. Generate with: openssl rand -base64 32
#   Changing it invalidates every unsubscribe link already sitting in people's
#   inboxes, so rotate it only if it leaks.
#
# NEWSLETTER_ADMIN_SECRET — bearer token for POST /api/newsletter/send, the
#   one endpoint that emails the whole list. Distinct from every other secret
#   here. Generate the same way.
#
# SUPABASE_SERVICE_ROLE_KEY — from the Supabase dashboard. Bypasses RLS, and
#   is the ONLY way to read subscriber addresses: the anon key has no table
#   privileges on newsletter_subscribers and no RPC that returns an address.
#   Note the deliberate absence of NEXT_PUBLIC_ — this key in a bundle would
#   expose the entire subscriber list and every other table in the project.
#
# NEWSLETTER_FROM_EMAIL — optional, defaults to "WaryTools <hello@wary.tools>".
#
# RESEND_API_KEY above is reused for sending. With it or the token secret
# unset, subscribing reports a clean "temporarily unavailable".
NEWSLETTER_TOKEN_SECRET=
NEWSLETTER_ADMIN_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# NEWSLETTER_FROM_EMAIL=

# Optional: raise the newsletter's daily send cap. Defaults to 100, which is
# Resend's free-tier limit.
#
# The send route reserves capacity for the whole run BEFORE claiming the slug
# and refuses a run it cannot finish. Without that, exceeding the limit sends
# to part of the list while marking the post sent — so the people at the tail
# never receive it and never can. Raise this only to what your Resend plan
# actually allows; setting it too high reintroduces exactly that failure.
#
# A malformed value falls back to 100 rather than disabling the guard.
# NEWSLETTER_DAILY_SEND_CAP=100

# Admin dashboard password (/admin). Server-only.
#
# Deliberately a DIFFERENT secret from NEWSLETTER_ADMIN_SECRET: that one
# authorises a send over the API and gets pasted into curl commands and shell
# history, while this is typed into a login box. Keeping them separate lets you
# pick something memorable here without weakening the API credential.
#
# The password is checked server-side once and exchanged for a signed httpOnly
# session cookie (12 hours), so it is never stored in the browser or placed in
# a URL. Logins are rate limited to 10 attempts per 15 minutes per IP.
#
# Requires NEWSLETTER_TOKEN_SECRET, which signs the session cookie.
NEWSLETTER_ADMIN_PASSWORD=
