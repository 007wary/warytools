NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL used by sitemap.js/robots.js/llms.txt and JSON-LD to
# build absolute URLs. Defaults to https://wary.tools — only set this for a
# deployment on a different domain (e.g. a staging environment). A trailing
# slash is normalized away, and a value with no scheme falls back to the
# default (see src/lib/siteUrl.js).
#
# Note: on Vercel, preview deploys serve robots.txt with "Disallow: /" so a
# *.vercel.app copy of the site can't be indexed alongside the canonical
# domain. That's keyed off VERCEL_ENV, which Vercel sets automatically —
# nothing to configure here.
# NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave unset in
# dev and preview deploys — analytics only loads when this is present.
NEXT_PUBLIC_GA_ID=

# Error tracking (Sentry). Same DSN value in both — NEXT_PUBLIC_ one is
# exposed to the browser for client-side error capture, SENTRY_DSN is used
# server/edge-side. Leave unset to run without error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: only needed to upload sourcemaps to Sentry during `next build`.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PDF to Word converter (services/pdf-to-word). Both are server-only — note
# the deliberate absence of NEXT_PUBLIC_: a converter secret in the browser
# bundle would be no secret at all, and the service would be open to anyone.
#
# Leave unset to run the site without the converter: /api/pdf-to-word then
# returns a clean "temporarily unavailable" message instead of failing hard,
# so local dev and previews work without deploying the container.
#
# See services/pdf-to-word/README.md for the deploy steps.
PDF_CONVERTER_URL=
PDF_CONVERTER_SECRET=

# Contact form (/contact -> /api/contact). Server-only, deliberately not
# NEXT_PUBLIC_: a mail-sending API key in the browser bundle would let anyone
# send email as us.
#
# Leave unset to run the site without the form working: /api/contact then
# returns a clean "temporarily unavailable" message instead of failing hard,
# so local dev and previews work without a Resend account.
#
# RESEND_API_KEY   — from https://resend.com/api-keys
# CONTACT_TO_EMAIL — the inbox that receives submissions (a personal address;
#   kept out of the code so it never lands in the repo or a bundle).
# CONTACT_FROM_EMAIL — optional. Defaults to "WaryTools <hello@wary.tools>",
#   which requires wary.tools to be verified in Resend. Set it to
#   "WaryTools <onboarding@resend.dev>" to send via Resend's shared domain
#   before verification completes — useful for a preview deploy.
#
# The sender's own address always goes in Reply-To, never in From: mail
# claiming to be From an address on a domain we don't control is exactly what
# SPF/DMARC reject, so it would land in spam.
#
# hello@wary.tools only SENDS. The domain has no MX records, so nothing is
# delivered to it — replies go to the visitor's address, and anything a person
# sends to hello@ bounces. Add MX records if that inbox is ever wanted.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
